menu "Stock watchlist"

    config STOCK_WIFI_SSID
        string "Default Wi-Fi SSID"
        default ""
        help
            Used only until credentials are saved with the "wifi" console command.
            Saved credentials (NVS) take precedence.

    config STOCK_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default ""

    config STOCK_REFRESH_INTERVAL_S
        int "Default quote refresh interval (seconds)"
        range 10 3600
        default 30
        help
            How often all quotes are fetched. Can be changed at run time with the
            "interval" console command.

endmenu
