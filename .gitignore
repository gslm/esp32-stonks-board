# ESP-IDF build output (recreated by idf.py build)
build/

# Components downloaded by the component manager (versions are pinned in dependencies.lock)
managed_components/

# Generated from sdkconfig.defaults on the first build, which is the tracked source of the
# configuration. menuconfig changes land here; copy the ones to keep into sdkconfig.defaults.
sdkconfig
sdkconfig.old

# Python and editor leftovers
__pycache__/
*.pyc
*.swp
*~
.DS_Store

# Per-machine VSCode settings: the ESP-IDF extension writes absolute paths into this file.
# Start from .vscode/settings.example.json (tracked).
.vscode/settings.json

# Wi-Fi passwords (the repo is public). Template: main/wifi_profiles_local.example.h
main/wifi_profiles_local.h
